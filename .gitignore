venv/
__pycache__/
*.pyc
.pytest_cache/
.env

# harness/session-local infrastructure (e.g. ScheduleWakeup's lock file) --
# not project content
.claude/

# training run logs and model artifacts -- regenerated every run, not source
data/processed/*.jsonl
data/processed/*_stdout.log
data/processed/*.joblib

# live-scoring price cache -- refreshed by src/data_pipeline/fetch_live.py
# on every run (daily churn expected), always regenerable, never the
# source of truth the way data/raw/training/*.csv currently is. Unlike
# the training set, this has no reason to be a stable, reviewable
# historical record in git history.
data/raw/live/

# scripts/score_live.py's dated recommendation output -- "today's
# recommendations", meaningless after the fact, regenerated every real
# run. The manually-maintained portfolio_state.json (updated once a
# recommendation is actually acted on) is the durable record, not this.
data/processed/live_recommendations/